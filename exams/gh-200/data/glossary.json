{
  "version": "1.0.0",
  "categories": [
    {
      "id": "D1",
      "title": "撰寫與管理工作流程",
      "terms": [
        {
          "id": "D1-T01",
          "term": "schedule",
          "explanation": "以 cron 設定的定時觸發，只在預設分支的檔案上執行；最短間隔每 5 分鐘，高負載時可能延遲，公開 repository 60 天無活動會停用。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T02",
          "term": "workflow_dispatch",
          "explanation": "手動觸發，可定義 inputs；只在預設分支的檔案上可用，最多 25 個頂層 input、資料量不超過 65,535 個字元。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T03",
          "term": "workflow_call",
          "explanation": "讓工作流程可被其他工作流程呼叫的事件，在 inputs 與 secrets 底下宣告可接受的參數。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T04",
          "term": "repository_dispatch",
          "explanation": "由外部以 API 送出的自訂事件；event_type 最多 100 個字元，client_payload 最多 10 個頂層屬性。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T05",
          "term": "pull_request",
          "explanation": "PR 事件，預設只在 opened、synchronize、reopened 執行；GITHUB_SHA 是 PR 的合併 commit。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T06",
          "term": "pull_request_target",
          "explanation": "在基底 repository 預設分支的 context 執行的特權觸發條件，可取得 secrets；不要搭配 checkout 不受信任的 PR 程式碼。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T07",
          "term": "GITHUB_SHA",
          "explanation": "觸發執行的 commit；pull_request 是合併 commit，schedule 與 workflow_run 是預設分支的最後 commit。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T08",
          "term": "GITHUB_REF",
          "explanation": "觸發執行的 ref；pull_request 是 refs/pull/編號/merge，schedule 是預設分支。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T09",
          "term": "permissions",
          "explanation": "設定 GITHUB_TOKEN 權限，可放在工作流程或 job 層；只要明確設定其中一項，沒列出的權限都變成 none。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T10",
          "term": "inputs context",
          "explanation": "保留 boolean 型別的輸入值 context，可直接用在條件。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T11",
          "term": "github.event.inputs",
          "explanation": "舊式輸入值 context，會把 boolean 轉成字串，所以與 false 比較永遠不成立。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T12",
          "term": "needs",
          "explanation": "建立 job 相依；被需要的 job 失敗或略過時，依賴它的 job 也會被略過。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T13",
          "term": "always()",
          "explanation": "狀態檢查函式，用在 job 的 if 時，無論相依 job 結果如何都執行。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T14",
          "term": "context 可用位置",
          "explanation": "不同位置可用的 context 不同，例如 jobs.<id>.if 可用 github、needs、vars、inputs，不含 secrets 與 env。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T15",
          "term": "vars context",
          "explanation": "讀取組織、repository、環境層級設定變數的 context，未設定時是空字串。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T16",
          "term": "steps outcome",
          "explanation": "套用 continue-on-error 之前的步驟結果。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T17",
          "term": "steps conclusion",
          "explanation": "套用 continue-on-error 之後的步驟結果。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T18",
          "term": "strategy.matrix",
          "explanation": "依變數組合展開成多個 job；每次執行最多 256 個 job。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T19",
          "term": "include",
          "explanation": "矩陣的擴充：加進所有不衝突的原始組合，會覆寫既有值時成為獨立的新組合。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T20",
          "term": "exclude",
          "explanation": "從矩陣移除特定組合，可只寫部分欄位比對。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T21",
          "term": "fail-fast",
          "explanation": "啟用時，一個 continue-on-error 為 false 的組合失敗，所有進行中與排隊的 job 都被取消。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T22",
          "term": "max-parallel",
          "explanation": "限制同時執行的矩陣 job 數量。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T23",
          "term": "服務容器 services",
          "explanation": "在 job 內宣告的相依服務；job 在容器內用標籤當主機，直接在 runner 上用 localhost 並設定 ports。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T24",
          "term": "快取鍵 key",
          "explanation": "快取的識別；查找順序為完全相同、key 前綴、restore-keys；快取不可變，要更新就用新鍵。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T25",
          "term": "restore-keys",
          "explanation": "找不到完全相同的 key 時依序比對的備援鍵。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T26",
          "term": "成品 artifact",
          "explanation": "在 job 之間或執行之後保存的檔案；v4 不可變，預設保留 90 天。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T27",
          "term": "GITHUB_ENV",
          "explanation": "寫入後讓之後的步驟取得環境變數；寫入的那一步看不到。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T28",
          "term": "GITHUB_OUTPUT",
          "explanation": "寫入步驟輸出，步驟需有 id，用 steps.<id>.outputs 讀取。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        },
        {
          "id": "D1-T29",
          "term": "GITHUB_STEP_SUMMARY",
          "explanation": "寫入工作摘要的 Markdown 檔，每個步驟上限 1 MiB。",
          "exams": ["GH-200"],
          "category": "撰寫與管理工作流程"
        }
      ]
    },
