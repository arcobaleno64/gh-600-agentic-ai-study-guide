          "exams": ["GH-200"],
          "category": "使用與疑難排解工作流程"
        },
        {
          "id": "D2-T14",
          "term": "gh run delete",
          "explanation": "命令列刪除整次執行；刪除執行時它的成品也一併刪除。",
          "exams": ["GH-200"],
          "category": "使用與疑難排解工作流程"
        },
        {
          "id": "D2-T15",
          "term": "可重用工作流程",
