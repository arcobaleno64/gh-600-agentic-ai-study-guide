          "exams": ["GH-200"],
          "category": "使用與疑難排解工作流程"
        },
        {
          "id": "D2-T22",
          "term": "github.event_name",
          "explanation": "辨認這次執行由哪個事件觸發的欄位。",
          "exams": ["GH-200"],
          "category": "使用與疑難排解工作流程"
        }
      ]
